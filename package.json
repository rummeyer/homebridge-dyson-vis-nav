{
    "name": "homebridge-dyson-vis-nav",
    "displayName": "Dyson 360 Vis Nav",
    "description": "A Homebridge plugin that exposes the Dyson 360 Vis Nav robot vacuum to Apple Home as a native Matter robot vacuum cleaner, or as a HomeKit switch when Matter is off, via the Dyson AWS IoT MQTT gateway.",
    "version": "1.0.6",
    "license": "ISC",
    "author": {
        "name": "Oliver Rummeyer",
        "url": "https://github.com/rummeyer"
    },
    "keywords": [
        "homebridge-plugin",
        "homebridge",
        "supports-matter",
        "supports-hap",
        "matter",
        "dyson",
        "360 Vis Nav",
        "RB03",
        "robot",
        "vacuum",
        "cleaner",
        "homekit"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rummeyer/homebridge-dyson-vis-nav.git"
    },
    "bugs": {
        "url": "https://github.com/rummeyer/homebridge-dyson-vis-nav/issues"
    },
    "homepage": "https://github.com/rummeyer/homebridge-dyson-vis-nav#readme",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/rummeyer"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/rummeyer"
        },
        {
            "type": "buymeacoffee",
            "url": "https://buymeacoffee.com/rummeyer"
        }
    ],
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": "^22 || ^24 || ^26",
        "homebridge": "^2.4.0"
    },
    "dependencies": {
        "@homebridge/plugin-ui-utils": "^2.2.6",
        "mqtt": "^5.15.2",
        "node-persist": "^4.0.4",
        "pngjs": "^7.0.0",
        "semver": "^7.8.5",
        "ts-interface-checker": "^1.0.2",
        "undici": "^8.10.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.2",
        "@types/node-persist": "^3.1.8",
        "@types/pngjs": "^6.0.5",
        "@types/semver": "^7.8.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "homebridge": "^2.4.0",
        "rimraf": "^6.1.3",
        "ts-interface-builder": "^0.3.3",
        "tsx": "^4.23.13",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.70.0"
    },
    "scripts": {
        "build-checkers": "mkdir -p ./src/ti && ts-interface-builder -c -o ./src/ti ./src/*-types.ts && tsx bin/ts-interface-post.ts ./src/ti",
        "build-tsc": "tsc -p ./src",
        "build": "npm run build-checkers && npm run build-tsc && npm run check-layout && npm run check-ui-config && npm run check-ui-server",
        "clean": "rimraf ./src/ti ./dist",
        "prepare": "npm run build",
        "lint": "eslint 'bin/**/*.ts' 'src/**/*.ts' --max-warnings=0",
        "prepublishOnly": "npm run build && npm run lint",
        "check-layout": "tsx bin/check-plugin-layout.ts",
        "check-ui-server": "node bin/check-ui-server.mjs",
        "check-ui-config": "node bin/check-ui-auth-config.mjs",
        "upstream": "node bin/upstream-sync.mjs",
        "check-session": "node bin/check-recorded-session.mjs"
    },
    "files": [
        "dist/",
        "homebridge-ui/",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ]
}
