{
    "pluginAlias": "DysonVisNav",
    "pluginType": "platform",
    "singular": true,
    "customUi": true,
    "customUiPath": "./homebridge-ui",
    "headerDisplay": "Exposes the Dyson 360 Vis Nav robot vacuum to Apple Home as a native Matter robot vacuum cleaner.\n\n**Matter must be enabled** in the Homebridge settings: a robot vacuum has no HomeKit (HAP) equivalent, so this plugin cannot work without it.",
    "footerDisplay": "Mock devices for development are set directly in config.json; see the README.",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "Name",
                "type": "string",
                "default": "Dyson 360 Vis Nav",
                "required": true,
                "description": "Name shown in the Homebridge log."
            },
            "provisioningMethod": {
                "title": "Provisioning Method",
                "type": "string",
                "default": "Remote Account",
                "enum": [
                    "Remote Account",
                    "Mock Devices"
                ],
                "description": "Kept for round-tripping; the Dyson 360 Vis Nav only supports the cloud gateway. \"Mock Devices\" is a development mode set by hand in config.json."
            },
            "dysonAccount": {
                "type": "object",
                "condition": {
                    "functionBody": "return model.provisioningMethod === 'Remote Account';"
                },
                "properties": {
                    "email": {
                        "title": "Email Address",
                        "type": "string",
                        "description": "The email address used with the MyDyson app. Entered in the MyDyson Account box above."
                    },
                    "password": {
                        "title": "Password",
                        "type": "string",
                        "description": "The password used with the MyDyson app. Entered in the MyDyson Account box above."
                    },
                    "china": {
                        "title": "Account registered in China",
                        "type": "boolean",
                        "default": false
                    },
                    "token": {
                        "title": "Authorisation Token",
                        "type": "string",
                        "description": "Optional. Only needed to supply a bearer token obtained elsewhere; the authorisation steps above store their token separately."
                    }
                }
            },
            "whiteList": {
                "title": "Serial Number Allow List",
                "type": "array",
                "items": {
                    "title": "Serial Number",
                    "type": "string"
                },
                "description": "If non-empty, only these serial numbers are exposed. Leave empty to expose every robot vacuum in the account."
            },
            "simpleModeTagsRvc": {
                "title": "Use simple RVC Clean Mode tags",
                "type": "boolean",
                "default": true,
                "description": "Advertise a single mode tag per cleaning mode. Disable only if your controller needs the full tag set."
            },
            "wildcardTopic": {
                "title": "Subscribe to wildcard MQTT topic",
                "type": "boolean",
                "default": false,
                "description": "Subscribe to all topics for the device. Useful for capturing logs when reporting an issue."
            },
            "logMapStyle": {
                "title": "Clean Map Logging",
                "type": "string",
                "default": "Off",
                "oneOf": [
                    {
                        "title": "Off",
                        "enum": [
                            "Off"
                        ]
                    },
                    {
                        "title": "Monospaced terminal",
                        "enum": [
                            "Monospaced"
                        ]
                    },
                    {
                        "title": "Homebridge log viewer",
                        "enum": [
                            "Homebridge"
                        ]
                    }
                ],
                "description": "Render a map of each completed clean into the log."
            },
            "unreachableTimeout": {
                "title": "Unreachable Timeout (seconds)",
                "type": "integer",
                "default": 120,
                "minimum": 10,
                "maximum": 3600,
                "description": "How long the robot may stay silent before Apple Home is told its activity is unknown. Until then the last known state is kept, so a brief network dropout does not make the tile flicker."
            },
            "debug": {
                "title": "Enable debug logging",
                "type": "boolean",
                "default": false
            },
            "debugFeatures": {
                "title": "Debug Features",
                "type": "array",
                "items": {
                    "title": "Feature",
                    "type": "string",
                    "enum": [
                        "Log API Headers",
                        "Log API Bodies",
                        "Log MQTT Client",
                        "Log MQTT Payloads",
                        "Log MQTT Payloads as JSON",
                        "Log Serial Numbers",
                        "Log Debug as Info"
                    ]
                }
            }
        }
    },
    "layout": [
        "name",
        {
            "type": "fieldset",
            "title": "Device Filtering",
            "expandable": true,
            "items": [
                {
                    "key": "whiteList",
                    "type": "array",
                    "title": "Serial Number Allow List",
                    "add": "Add serial number",
                    "items": [
                        {
                            "key": "whiteList[]",
                            "type": "string",
                            "title": "Serial Number",
                            "placeholder": "e.g. ABC-EU-XXX1234A"
                        }
                    ]
                }
            ]
        },
        {
            "type": "fieldset",
            "title": "Advanced",
            "expandable": true,
            "items": [
                "simpleModeTagsRvc",
                "wildcardTopic",
                "logMapStyle",
                "unreachableTimeout",
                "debug",
                {
                    "key": "debugFeatures",
                    "type": "array",
                    "title": "Debug Features",
                    "add": "Add debug feature",
                    "items": [
                        {
                            "key": "debugFeatures[]",
                            "type": "select",
                            "title": "Feature",
                            "titleMap": [
                                {
                                    "value": "Log API Headers",
                                    "name": "Log API Headers"
                                },
                                {
                                    "value": "Log API Bodies",
                                    "name": "Log API Bodies"
                                },
                                {
                                    "value": "Log MQTT Client",
                                    "name": "Log MQTT Client"
                                },
                                {
                                    "value": "Log MQTT Payloads",
                                    "name": "Log MQTT Payloads"
                                },
                                {
                                    "value": "Log MQTT Payloads as JSON",
                                    "name": "Log MQTT Payloads as JSON"
                                },
                                {
                                    "value": "Log Serial Numbers",
                                    "name": "Log Serial Numbers"
                                },
                                {
                                    "value": "Log Debug as Info",
                                    "name": "Log Debug as Info"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "key": "dysonAccount.email",
            "type": "hidden"
        },
        {
            "key": "dysonAccount.password",
            "type": "hidden"
        },
        {
            "key": "dysonAccount.china",
            "type": "hidden"
        },
        {
            "key": "dysonAccount.token",
            "type": "hidden"
        },
        {
            "key": "provisioningMethod",
            "type": "hidden"
        }
    ]
}
